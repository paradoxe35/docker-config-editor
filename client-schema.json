{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "burrow client config",
  "type": "object",
  "properties": {
    "server": {
      "description": "Server address: host or host:port for TCP (port 7835 when omitted), or ws://host/path or wss://host/path",
      "type": "string"
    },
    "name": {
      "description": "This client's name, as defined in the server config",
      "type": "string"
    },
    "secret": {
      "description": "256-bit secret (base64 or hex) shared with the server",
      "type": "string"
    },
    "allow": {
      "description": "Targets the server may reach: CIDR, optionally with :port or :lo-hi",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_all": {
      "description": "Allow the server to reach any target (not recommended)",
      "type": "boolean"
    },
    "insecure_plaintext": {
      "type": "boolean"
    },
    "headers": {
      "description": "Extra HTTP headers for the WebSocket upgrade, for example an access token for a proxy",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ca": {
      "description": "CA certificate, or the server certificate itself (pinned), to trust for wss://; relative to the config file",
      "type": [
        "string",
        "null"
      ]
    },
    "cipher": {
      "$ref": "#/$defs/Cipher"
    },
    "proxy": {
      "description": "Connect through a proxy: http://host:port or socks5://[user:pass@]host:port",
      "type": [
        "string",
        "null"
      ]
    },
    "reconnect": {
      "$ref": "#/$defs/Reconnect"
    },
    "connect_timeout_secs": {
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 300
    },
    "max_connections": {
      "description": "Most connections open through this client at once; beyond it the server gets busy. Lowered automatically when the open file limit is too small",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1000000,
      "default": 16384,
      "x-show-default": true
    },
    "max_udp_peers": {
      "description": "Most UDP peers open through this client at once, across all UDP services; a datagram from a new peer beyond it is dropped. Lowered automatically when the open file limit is too small",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1000000,
      "default": 8192,
      "x-show-default": true
    },
    "tcp": {
      "$ref": "#/$defs/TcpOptions"
    },
    "udp": {
      "$ref": "#/$defs/ClientUdpOptions"
    },
    "update": {
      "$ref": "#/$defs/ClientUpdate"
    }
  },
  "additionalProperties": false,
  "required": [
    "server",
    "name",
    "secret"
  ],
  "$defs": {
    "Cipher": {
      "type": "string",
      "enum": [
        "chachapoly",
        "aes-gcm"
      ]
    },
    "Reconnect": {
      "type": "object",
      "properties": {
        "initial_delay_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 10,
          "maximum": 60000,
          "default": 250
        },
        "max_delay_secs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 3600,
          "default": 30
        },
        "give_up_after_secs": {
          "description": "Stop retrying after this long without a working connection to the server; 0 retries forever",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "on_rejected": {
          "description": "What to do when the server rejects the secret or name",
          "$ref": "#/$defs/OnRejected",
          "default": "retry"
        }
      },
      "additionalProperties": false
    },
    "OnRejected": {
      "type": "string",
      "enum": [
        "retry",
        "exit"
      ]
    },
    "TcpOptions": {
      "type": "object",
      "properties": {
        "nodelay": {
          "type": "boolean",
          "default": true
        },
        "keepalive_secs": {
          "description": "TCP keepalive idle time, 0 disables",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "maximum": 32767,
          "default": 30
        }
      },
      "additionalProperties": false
    },
    "ClientUdpOptions": {
      "type": "object",
      "properties": {
        "session_timeout_secs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "default": 120
        }
      },
      "additionalProperties": false
    },
    "ClientUpdate": {
      "type": "object",
      "properties": {
        "remote": {
          "description": "Let the server's admin ask this client to update to a newer published release; the client downloads and checks it itself",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
